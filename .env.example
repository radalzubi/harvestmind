# HarvestMind Environment Configuration
# Copy to .env and fill in values before running

# ── Database ───────────────────────────────────────────────────────────────────
# Use "duckdb" for local development, "postgresql" for production
DATABASE_BACKEND=duckdb
DUCKDB_PATH=./harvestmind.duckdb
POSTGRES_URL=postgresql://user:password@localhost:5432/harvestmind

# ── Solvers ────────────────────────────────────────────────────────────────────
# Set to "true" if Gurobi academic license is installed
GUROBI_AVAILABLE=false
# If true, HiGHS is used as fallback (always available)
HIGHS_FALLBACK=true

# ── External API Keys ──────────────────────────────────────────────────────────
USDA_NASS_API_KEY=your-nass-api-key-here          # https://quickstats.nass.usda.gov/api
NOAA_CDO_TOKEN=your-noaa-token-here               # https://www.ncdc.noaa.gov/cdo-web/token
# USDA AMS MARS API: no key required
# NWS api.weather.gov: no key required
# NASA POWER: no key required
# US Drought Monitor: no key required

# ── QuickBooks Online (optional) ───────────────────────────────────────────────
QBO_CLIENT_ID=
QBO_CLIENT_SECRET=
QBO_REDIRECT_URI=http://localhost:8000/auth/qbo/callback
QBO_SANDBOX=true

# ── Local Line (optional) ──────────────────────────────────────────────────────
LOCAL_LINE_API_KEY=

# ── App Config ────────────────────────────────────────────────────────────────
APP_ENV=development                               # development | staging | production
LOG_LEVEL=INFO
SECRET_KEY=change-me-in-production-32-chars-min

# ── API security ──────────────────────────────────────────────────────────────
# Comma-separated CORS allowlist. Default is localhost-only. Set explicitly
# for any non-local deployment. Never use "*" with partner data.
CORS_ALLOWED_ORIGINS=http://localhost,http://localhost:8000,http://localhost:8501
# Required for any networked pilot. Local development may leave this false.
# Deployment environment: dev | pilot | staging | prod.
# Anything other than dev ENFORCES authentication regardless of the flag
# below (fail-closed): a networked pilot cannot ship on the dev default.
HARVESTMIND_ENV=dev
HARVESTMIND_AUTH_REQUIRED=false
# Leave unset to disable admin token issuance and training controls entirely.
HARVESTMIND_ADMIN_KEY=
# Per-process protection for expensive endpoints; ingress limits are still required.
HARVESTMIND_RATE_LIMIT_PER_MIN=0
# Registry, isolated vault databases, uploads, sessions, and exports.
HARVESTMIND_DATA_ROOT=./data

# ── Demo / Synthetic Data ──────────────────────────────────────────────────────
SYNTHETIC_SEED=42
SYNTHETIC_HUB_GMV=3000000
SYNTHETIC_N_SUPPLIERS=12
SYNTHETIC_N_BUYERS=25
SYNTHETIC_N_SKUS=40
SYNTHETIC_N_WEEKS=104

# ── LLM Extraction Layer ───────────────────────────────────────────────────────
# Install the optional extra (`pip install -e '.[llm]'`), set
# USE_REAL_LLM=true, and add your Anthropic API key to activate real extraction.
# Get your key at: console.anthropic.com
# SET A MONTHLY SPEND LIMIT BEFORE ACTIVATING: console.anthropic.com -> Billing
# See docs/LLM_ACTIVATION.md for the full checklist.
USE_REAL_LLM=false
ANTHROPIC_API_KEY=     # inject before pilot — leave blank in mock mode
EXTRACTION_MODEL=claude-sonnet-4-20250514

# ── ZAAD canonical planning engine (post-P1 integration) ─────────────────────
# The frozen P1 optimizer under /api/zaad/network is the only planning engine of the product.
# The superseded engines (/api/zaad first engine, /fmcg/plan legacy modes) are served only when
# this is 1; unset = enabled in dev only, disabled in pilot / staging / prod. Production: 0.
ZAAD_LEGACY_PLANNERS=0
# Durable storage for asynchronous planning jobs and the shadow decision ledger (never the training DB).
ZAAD_JOB_STORE=./data/zaad_jobs.sqlite
ZAAD_SHADOW_LEDGER=./data/zaad_shadow.sqlite
