+def _intervenes(candidate: Solution | None, incumbent: Solution) -> bool:
+    """Does a candidate's executable (period-0) order differ from the incumbent's? Numerical
+    tolerance only; no economic threshold is applied here."""
+    if candidate is None or not candidate.usable_plan:
+        return False
+    keys = {k for k in candidate.purchases if k[1] == 0} | {k for k in incumbent.purchases if k[1] == 0}
+    return any(abs(candidate.purchases.get(k, 0.) - incumbent.purchases.get(k, 0.)) > 1e-6 for k in keys)
+
